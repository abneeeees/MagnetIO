# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project_id].supabase.co:5432/postgres
SUPABASE_URL=https://[project_id].supabase.co

# JWT Secret Key 
# Generate using bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Supabase Keys
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Torrent engine
# Folder where WebTorrent writes pieces. Use a large/persistent volume in prod.
TORRENT_PATH=/tmp/webtorrent
# Remove a torrent after this many ms with no active stream (default 120000).
TORRENT_IDLE_TTL_MS=120000
# Max torrents kept loaded at once; idle ones are evicted (default 3).
MAX_ACTIVE_TORRENTS=3
# Optional max size (bytes) for a single streamed file; 0 disables (default 0).
MAX_STREAM_FILE_BYTES=0